# Copy to .env and adjust. Every value below is optional — the app boots
# with safe defaults if this file does not exist.

# Public base URL used when rendering review links. Set this to the URL your
# reviewers will actually open, otherwise the links you copy will point at
# localhost.
APPROVAL_PACK_BASE_URL=http://localhost:8000

# SQLite by default. The parent directory is created automatically.
APPROVAL_PACK_DATABASE_URL=sqlite:///./data/approval_pack.db

# Where uploaded snapshot files are stored.
APPROVAL_PACK_STORAGE_DIR=./data/snapshots

# Upload limits.
APPROVAL_PACK_MAX_UPLOAD_BYTES=5242880
APPROVAL_PACK_MAX_TEXT_CHARS=200000

# Entropy behind each review token, in bytes. 32 bytes = 256 bits.
APPROVAL_PACK_REVIEW_TOKEN_BYTES=32

# Optional shared password for the owner area (creating and listing
# approvals). Leave empty for an open instance — fine on localhost, not on a
# public host. The review links themselves never require a login.
APPROVAL_PACK_OWNER_PASSWORD=

# Used to sign the owner session cookie. Change it if you set a password.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_PACK_SECRET_KEY=change-me

APPROVAL_PACK_DEBUG=false
